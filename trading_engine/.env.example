# ---- Finite resource pools (never topped up) ----
CAPITAL_BASE_CAD=100.00
CREDIT_BUDGET_CAD=100.00

# ---- Universe & venue ----
# tsx    -> Canadian ETFs (synthetic/yahoo feed, Wealthsimple-style fee model)
# crypto -> Kraken CAD spot pairs (BTC/CAD, ETH/CAD, SOL/CAD, XRP/CAD, ADA/CAD, DOGE/CAD), percentage fees
ASSET_UNIVERSE=crypto
# mock | kraken
BROKER=kraken
# synthetic | yahoo | kraken_live
DATA_FEED=kraken_live

# ---- Paper-soak mode (run 48h before risking principal) ----
# true  -> live market data + live spreads, but ALL orders route to the mock broker (BROKER=kraken is ignored)
# false -> real orders (also requires LIVE_TRADING_ENABLED=true and Kraken keys)
PAPER_LIVE_FEED=true
# per-side fee applied by the mock broker in paper mode (0.40% = Kraken tier-0 taker, what market orders pay)
PAPER_FEE_BPS=40

# ---- Kraken (API key scopes: Query Funds + Create & Modify Orders ONLY. Never grant Withdraw Funds.) ----
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=
# your fee tier in basis points per side (tier-0 published: maker 25 / taker 40)
KRAKEN_MAKER_BPS=25
KRAKEN_TAKER_BPS=40
# Hard safety switch. No live order is ever sent unless this is "true" AND PAPER_LIVE_FEED=false.
LIVE_TRADING_ENABLED=false

# ---- Notifications (profit sweeps, drawdown halts, safe mode) ----
# Discord:  https://discord.com/api/webhooks/<id>/<token>
# Telegram: https://api.telegram.org/bot<token>/sendMessage  (+ TELEGRAM_CHAT_ID)
# Anything else receives a generic JSON POST {title, text, data, ts}
WEBHOOK_URL=
TELEGRAM_CHAT_ID=

# ---- Claude bridge (cost-gated; the daemon never calls the LLM in its polling loop) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-fable-5-1
CLAUDE_BRIDGE_ENABLED=false
USD_CAD_RATE=1.37

# ---- Runtime ----
SYNTHETIC_SEED=42
LEDGER_PATH=trading_engine/ledger.db
POLL_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
