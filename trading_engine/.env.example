# ---- Finite resource pools (never topped up) ----
CAPITAL_BASE_CAD=100.00
CREDIT_BUDGET_CAD=100.00

# ---- Broker ----
# mock | questrade
BROKER=mock
# Hard safety switch. Even with credentials present, no live order is sent unless this is "true".
LIVE_TRADING_ENABLED=false
# Questrade API (only if BROKER=questrade). Never commit real values.
QUESTRADE_REFRESH_TOKEN=
QUESTRADE_ACCOUNT_ID=

# ---- Market data ----
# synthetic | yahoo
DATA_FEED=synthetic
SYNTHETIC_SEED=42

# ---- Claude bridge (cost-gated; the daemon never calls the LLM in its polling loop) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-fable-5-1
CLAUDE_BRIDGE_ENABLED=false
USD_CAD_RATE=1.37

# ---- Runtime ----
LEDGER_PATH=trading_engine/ledger.db
POLL_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
